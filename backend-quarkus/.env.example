# ┌──────────────────────────────────────────────────────────────────────────────┐
# │  WrapHouse Backend — Variables de Entorno                                  │
# │  Copia este archivo a .env y rellena los valores reales.                   │
# │  NUNCA commitees el archivo .env (ya está en .gitignore)                   │
# └──────────────────────────────────────────────────────────────────────────────┘

# ── PostgreSQL ───────────────────────────────────────────────────────────────────
# LOCAL:  usa localhost sin SSL
# RENDER: usa el host externo + ?sslmode=require
#
# Para desarrollo local:
#   DB_HOST=localhost
#   DB_PARAMS=
#
# Para Render (externo desde tu PC):
#   DB_HOST=dpg-XXXXX-a.virginia-postgres.render.com
#   DB_PARAMS=?sslmode=require
#
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wraphouse
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_password
DB_PARAMS=

# ── Pool de conexiones ──────────────────────────────────────────────────────────
# Render free tier: máximo ~97 conexiones. Mantén max-size bajo.
DB_POOL_MIN=2
DB_POOL_MAX=8

# ── Servidor ─────────────────────────────────────────────────────────────────────
PORT=8860
CORS_ORIGINS=http://localhost:4200

# ── Hibernate ────────────────────────────────────────────────────────────────────
# update  = crea/actualiza tablas automáticamente (desarrollo)
# validate = solo verifica que el esquema coincida (producción estable)
# none    = no toca el esquema
HIBERNATE_DDL=update

# ── Logging ──────────────────────────────────────────────────────────────────────
# DEBUG = ver queries SQL en consola, WARN = silenciar
SQL_LOG_LEVEL=WARN
